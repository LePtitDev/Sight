<Project>
  <ItemGroup>
    <!-- Libraries: keep the lowest reasonable version so consumers are not forced to upgrade -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="8.0.1" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    <PackageVersion Include="System.Collections.Immutable" Version="10.0.13" />
    <PackageVersion Include="Nullable" Version="1.3.1" />
    <PackageVersion Include="System.Memory" Version="4.6.3" />
    <PackageVersion Include="System.Threading.Tasks.Extensions" Version="4.6.3" />
    <PackageVersion Include="System.Threading.Channels" Version="8.0.0" />
    <!-- Tests -->
    <PackageVersion Include="NUnit" Version="5.0.0" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.3.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="NunitXml.TestLogger" Version="8.0.0" />
    <PackageVersion Include="System.IO.Hashing" Version="10.0.13" />
    <!-- Benchmarks -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="DryIoc" Version="5.4.3" />
    <PackageVersion Include="Autofac" Version="9.3.4" />
    <PackageVersion Include="MessagePack" Version="3.1.12" />
  </ItemGroup>
</Project>
